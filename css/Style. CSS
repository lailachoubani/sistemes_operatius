/* ==========================================================================
   Instal·lació d'Ubuntu en una màquina virtual
   Paleta inspirada en Ubuntu: berenjena (aubergine) i taronja.
   Ús:  <link rel="stylesheet" href="style.css">
        <ol class="abc"> ... </ol>   per als passos a/ b/ c/
        <p class="avis"> ... </p>    per a un avís destacat
   ========================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,400;0,500;0,700;1,400&family=Ubuntu+Mono:wght@400;700&display=swap");

/* ---------- Colors i tipografia ---------- */
:root {
  --aubergine: #2c001e;
  --plum: #5e2750;
  --orange: #e95420;
  --link: #bf3f0e;

  --bg: #f8f4f7;
  --card: #ffffff;
  --text: #2d2332;
  --muted: #6f6376;
  --heading: #2c001e;
  --subheading: #5e2750;
  --line: #e7dce5;
  --code-bg: #f3e7f0;
  --code-fg: #5e2750;
  --callout-bg: #fff0e8;
  --callout-line: #f3b79d;
  --terminal: #300a24;
  --zebra: rgba(94, 39, 80, .05);
  --shadow: 0 1px 2px rgba(44, 0, 30, .06), 0 10px 28px rgba(44, 0, 30, .09);
  --img-shadow: 0 8px 22px rgba(44, 0, 30, .16);

  --font-body: "Ubuntu", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "Ubuntu Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}

@media (prefers-color-scheme: dark) {
  :root {
    --link: #ff9a70;
    --bg: #1b0b17;
    --card: #28121f;
    --text: #efe5ed;
    --muted: #b8a5b4;
    --heading: #fbeef7;
    --subheading: #e3a6d0;
    --line: #432a3c;
    --code-bg: #3b1f34;
    --code-fg: #f3c3e3;
    --callout-bg: #3a1c1a;
    --callout-line: #7a3b25;
    --terminal: #12040e;
    --zebra: rgba(255, 255, 255, .04);
    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 10px 28px rgba(0, 0, 0, .35);
    --img-shadow: 0 8px 22px rgba(0, 0, 0, .5);
  }
}

/* ---------- Base ---------- */
* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0 auto;
  max-width: 54rem;
  padding: 2.5rem 1rem 4rem;
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--text);
  background:
    radial-gradient(48rem 20rem at 100% -5rem, rgba(233, 84, 32, .16), transparent 70%),
    radial-gradient(44rem 20rem at 0 -4rem, rgba(94, 39, 80, .20), transparent 70%),
    var(--bg);
  background-repeat: no-repeat;
}

::selection { background: var(--orange); color: #fff; }

/* ---------- Títols ---------- */
h1, h2, h3, h4 {
  line-height: 1.2;
  text-wrap: balance;
}

h1 {
  margin: 0 0 1.25rem;
  font-size: clamp(2rem, 6vw, 3.1rem);
  font-weight: 700;
  letter-spacing: -.02em;
  color: var(--heading);
}

h1::after {
  content: "";
  display: block;
  width: 4.5rem;
  height: .35rem;
  margin-top: .9rem;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--orange), #f6a07a);
}

h1 + p {
  font-size: 1.2rem;
  color: var(--muted);
}

h2 {
  margin: 3rem 0 1rem;
  padding-bottom: .45rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--heading);
  border-bottom: 2px solid var(--line);
}

h3 {
  margin: 2.25rem 0 .6rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--subheading);
}

h4 {
  margin: 1.75rem 0 .5rem;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--subheading);
}

p { margin: 0 0 1rem; }

strong { font-weight: 700; color: var(--heading); }

/* ---------- Enllaços ---------- */
a {
  color: var(--link);
  text-decoration: underline;
  text-decoration-thickness: .1em;
  text-underline-offset: .2em;
}
a:hover { color: var(--orange); }
a:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 3px;
  border-radius: .25rem;
}

/* ---------- Codi ---------- */
code {
  font-family: var(--font-mono);
  font-size: .98em;
  padding: .1em .45em;
  border-radius: .4em;
  background: var(--code-bg);
  color: var(--code-fg);
}

pre {
  margin: 1.5rem 0;
  padding: 1.1rem 1.3rem;
  overflow-x: auto;
  border-radius: 1rem;
  background: var(--terminal);
  color: #f3e9f0;
  box-shadow: var(--shadow);
  line-height: 1.55;
}
pre code {
  padding: 0;
  background: none;
  color: inherit;
  font-size: 1rem;
}

/* ---------- Llistes ---------- */
ul, ol { padding-left: 1.5rem; }
li::marker { color: var(--orange); font-weight: 700; }

/* ---------- Passos a/ b/ c/ ---------- */
ol.abc {
  list-style: none;
  counter-reset: pas;
  margin: 2.5rem 0;
  padding: 0;
  display: grid;
  gap: 2.5rem;
}

ol.abc > li {
  counter-increment: pas;
  position: relative;
  padding: 2.1rem 1.5rem 1.5rem;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 1.25rem;
  box-shadow: var(--shadow);
}

ol.abc > li::before {
  content: counter(pas, lower-alpha) "/";
  position: absolute;
  top: -1.3rem;
  left: 1.25rem;
  display: grid;
  place-items: center;
  width: 2.6rem;
  height: 2.6rem;
  border-radius: .9rem;
  background: var(--orange);
  color: #fff;
  font-size: 1.2rem;
  font-weight: 700;
  box-shadow: 0 6px 16px rgba(233, 84, 32, .4);
}

/* ---------- Imatges (captures) ---------- */
img {
  display: block;
  max-width: 100%;
  height: auto;
}

li img,
figure img,
p > img {
  margin: 1.1rem 0 0;
  border: 1px solid var(--line);
  border-radius: .9rem;
  background: var(--card);
  box-shadow: var(--img-shadow);
  transition: transform .2s ease, box-shadow .2s ease;
}

li img:hover,
figure img:hover {
  transform: translateY(-3px) scale(1.01);
  box-shadow: 0 14px 30px rgba(44, 0, 30, .24);
}

img.portada {
  width: 100%;
  margin: 0 0 2rem;
  border: 0;
  border-radius: 1.5rem;
  box-shadow: var(--shadow);
}

figure { margin: 1.5rem 0; }
figcaption {
  margin-top: .55rem;
  padding-inline: .25rem;
  font-size: .9rem;
  line-height: 1.45;
  color: var(--muted);
}

/* ---------- Avís destacat ---------- */
.avis,
blockquote {
  margin: 1.5rem 0;
  padding: 1rem 1.25rem;
  border: 1px solid var(--callout-line);
  border-radius: 1rem;
  background: var(--callout-bg);
}
.avis::before {
  content: "Compte";
  display: block;
  margin-bottom: .2rem;
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--link);
}
blockquote > :last-child,
.avis > :last-child { margin-bottom: 0; }

/* ---------- Taules ---------- */
table {
  width: 100%;
  margin: 1.5rem 0;
  border-collapse: separate;
  border-spacing: 0;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: var(--card);
  box-shadow: var(--shadow);
  font-size: .97rem;
  font-variant-numeric: tabular-nums;
}
th, td {
  padding: .7rem 1rem;
  text-align: left;
  border-bottom: 1px solid var(--line);
}
th {
  background: var(--plum);
  color: #fff;
  font-weight: 700;
  letter-spacing: .03em;
}
th:first-child { border-top-left-radius: .9rem; }
th:last-child { border-top-right-radius: .9rem; }
tbody tr:nth-child(even) td { background: var(--zebra); }
tr:last-child td { border-bottom: 0; }
tr:last-child td:first-child { border-bottom-left-radius: .9rem; }
tr:last-child td:last-child { border-bottom-right-radius: .9rem; }

/* ---------- Separador i peu ---------- */
hr {
  height: 2px;
  margin: 3rem 0;
  border: 0;
  background: linear-gradient(90deg, var(--orange), var(--plum), transparent);
}

footer {
  margin-top: 4rem;
  font-size: .9rem;
  text-align: center;
  color: var(--muted);
}

/* ---------- Mòbil ---------- */
@media (max-width: 40rem) {
  body { padding-top: 1.5rem; }
  h2 { font-size: 1.5rem; }
  ol.abc > li { padding: 2rem 1rem 1.1rem; }
  th, td { padding: .6rem .7rem; }
}

/* ---------- Menys moviment ---------- */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  li img, figure img { transition: none; }
  li img:hover, figure img:hover { transform: none; }
}
